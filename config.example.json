{
  "endpoints": [
    {
      "expect_status": 200,
      "alert_threshold": 5,
      "alert_cooldown_s": 3600,
      "headers": {
        "X-Api-Key": "example-key"
      },
      "maintenance_windows": [
        {
          "days": "sat",
          "end": "04:00",
          "start": "02:00"
        }
      ],
      "max_latency_ms": 500,
      "name": "example",
      "retry_on_failure": true,
      "sla_target": 99.9,
      "timeout": 5,
      "type": "http",
      "url": "https://example.com",
      "webhook": "https://hooks.example.com/example"
    },
    {
      "host": "127.0.0.1",
      "name": "localhost-ssh",
      "port": 22,
      "timeout": 5,
      "type": "tcp"
    },
    {
      "check_interval_s": 120,
      "depends_on": "example",
      "name": "example-api",
      "timeout": 5,
      "type": "http",
      "url": "https://example.com/api"
    }
  ],
  "flap_threshold": 3,
  "history": 100,
  "history_file": "history.json",
  "interval_seconds": 30,
  "status_page_sources": [
    {
      "label": "second-site",
      "path": "history-second.json"
    }
  ]
}
