{
  "endpoints": [
    {
      "name": "example",
      "timeout": 5,
      "type": "http",
      "url": "https://example.com",
      "maintenance_windows": [
        {"days": "sat", "start": "02:00", "end": "04:00"}
      ]
    },
    {
      "host": "127.0.0.1",
      "name": "localhost-ssh",
      "port": 22,
      "timeout": 5,
      "type": "tcp"
    },
    {
      "depends_on": "example",
      "name": "example-api",
      "timeout": 5,
      "type": "http",
      "url": "https://example.com/api"
    }
  ],
  "flap_threshold": 3,
  "history": 100,
  "history_file": "history.json",
  "interval_seconds": 30
}
